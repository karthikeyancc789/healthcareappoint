// Healthcare Appointment & Follow-up Manager — Database Schema
// Provider: SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Google Calendar OAuth tokens (per user, so each side's calendar gets an event)
  googleRefreshToken String?
  googleAccessToken  String?
  googleTokenExpiry  DateTime?

  doctorProfile  Doctor?
  patientProfile Patient?

  @@index([role])
}

model Doctor {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String
  slotDurationMin Int     @default(30)
  workingHours   String   // e.g. { "MON": ["09:00","17:00"], "TUE": ["09:00","17:00"], ... } - Stored as stringified JSON
  createdAt      DateTime @default(now())

  leaves       DoctorLeave[]
  appointments Appointment[]

  @@index([specialisation])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date]) // a doctor can only mark a given date on leave once
  @@index([doctorId, date])
}

model Patient {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dob       DateTime?
  gender    String?
  createdAt DateTime @default(now())

  appointments Appointment[]
}

// Core booking entity.
model Appointment {
  id          String            @id @default(uuid())
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  slotStart   DateTime          // exact start timestamp of the slot (UTC)
  slotEnd     DateTime
  status      String            @default("PENDING")

  holdExpiresAt DateTime?

  symptomText     String?
  preVisitSummary String?     // { urgencyLevel, chiefComplaint, suggestedQuestions[] } - Stored as stringified JSON

  doctorNotes      String?
  prescription      String?    // [{ medicine, dosage, frequencyPerDay, durationDays }] - Stored as stringified JSON
  postVisitSummary  String?  // LLM-generated patient-friendly text

  googleEventIdPatient String?
  googleEventIdDoctor  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]

  // Final safety net against double-booking
  @@unique([doctorId, slotStart], name: "doctor_slot_unique")
  @@index([patientId])
  @@index([doctorId, slotStart])
  @@index([status, holdExpiresAt])
}

// Every outbound email / calendar action is logged here
model Notification {
  id            String              @id @default(uuid())
  appointmentId String
  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientUserId String
  channel       String
  type          String
  status        String              @default("PENDING")
  attempts      Int                 @default(0)
  lastError     String?
  payload       String?               // rendered subject/body or calendar event payload, for retry - Stored as stringified JSON
  scheduledFor  DateTime            @default(now()) // when it should fire (used for reminders)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database (PostgreSQL) ---
# Example (local): postgresql://postgres:postgres@localhost:5432/healthcare_db
# Example (Render/Railway): provided by the hosting dashboard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_db

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Slot hold mechanism ---
# Minutes a slot is reserved for a patient while they fill the symptom form
SLOT_HOLD_MINUTES=10

# --- LLM (Anthropic) ---
# Used for pre-visit symptom summaries and post-visit patient-friendly summaries
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (choose ONE provider and fill its vars) ---
EMAIL_PROVIDER=smtp
# Generic SMTP / Nodemailer (works with Mailtrap, Gmail app password, SendGrid SMTP relay, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM="Healthcare Clinic <no-reply@clinic.com>"

# --- Google Calendar (OAuth 2.0) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/calendar/oauth/callback

# --- Background jobs ---
# Cron expressions (default: every 5 min for reminders/retries sweep)
REMINDER_JOB_CRON=*/5 * * * *
EMAIL_RETRY_JOB_CRON=*/2 * * * *
SLOT_HOLD_SWEEP_CRON=* * * * *
